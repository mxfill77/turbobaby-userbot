+def _sp_event_note(kind, works, km):
+    """Текст строки истории обслуживания: НАЗВАННАЯ работа, а не ярлык (14.08.2026).
+
+    Ярлык `_SP_KIND_LABEL` НЕ снимается и снят быть не может — на нём стои́т РАСЧЁТ: ключ `kind`
+    адресует регистр (oil→кол.I, gear→J, abs→K, airfilter→L и интервалы `service_upsert`), он же
+    несёт идемпотентность (`msg_id=sp:…:{kind}:{km}`) и обе половины квитанции/карточку отмены.
+    Здесь меняется РОВНО одно — человекочитаемый текст строки: механик работу НАЗВАЛ → в историю
+    идут его слова (как давно делает соседняя ветка `_write_info_works`); не назвал → ярлык, и по
+    ярлыку видно, что названия не было. Живой случай: байк 9548, 14.08 — «замена аккумулятора»
+    легла в историю как «прочие работы».
+
+    Слова сопоставляем с регистром ТЕМ ЖЕ классификатором, что построил `done` (`_service_kind`),
+    иначе в строку попало бы чужое название. Длину режем как `_write_info_works` — 200."""
+    named = [w for w in (works or []) if _service_kind(w) == kind]
+    what = "; ".join(named) if named else _SP_KIND_LABEL.get(kind, (kind, kind))[1]
+    return (f"{what} — {km} км" if km else f"{what}")[:200]
+
