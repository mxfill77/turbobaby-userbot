#!/bin/sh
# pre-commit — СТОРОЖ РЕЕСТРОВ ЗАВИСИМОСТЕЙ ДЕМОНА (см. deps_registry_check.py).
#
# Зачем хук, а не «помнить»: расхождение реестра с фактом импортов до 01.09.2026 узнавал не автор
# правки, а демон — на self-update, часы спустя, отказом эстафеты. Здесь оно видно на коммите.
#
# Полярность отказов выбрана сознательно:
#   • сторож сказал «расхождение» (код 1) → коммит ДЕРЖИМ (это ровно то, что чинить);
#   • сторож не смог/не нашёлся/питона нет  → коммит ПРОПУСКАЕМ, но ГРОМКО. Хук — ранний слой,
#     жёсткая сеть под ним (unittest-гейт демона) осталась; сломанный сторож не имеет права
#     заблокировать полосе коммиты.
#
# Ставится так (местная настройка, в git не версионируется):
#   git config core.hooksPath deploy/hooks
# Снимается так:
#   git config --unset core.hooksPath
# Разовый обход: git commit --no-verify
set -u

repo="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$repo" ] || exit 0

check="$repo/deps_registry_check.py"
[ -f "$check" ] || exit 0          # сторожа нет в дереве (старый коммит, чужая ветка) — не мешаем

py="$repo/venv/Scripts/python.exe"
if [ ! -f "$py" ]; then
    py="$(command -v python 2>/dev/null || command -v python3 2>/dev/null || true)"
fi
if [ -z "$py" ]; then
    echo "⚠️ pre-commit: интерпретатора нет — реестры зависимостей НЕ СВЕРЕНЫ (коммит пропущен)" >&2
    exit 0
fi

"$py" "$check" --staged --quiet
rc=$?
[ "$rc" = "1" ] && exit 1          # расхождение названо поимённо самим сторожем
exit 0
