{
  "model": "claude-fable-5",
  "effortLevel": "xhigh",
  "alwaysThinkingEnabled": true,
  "env": {
    "MAX_THINKING_TOKENS": "31999"
  },
  "permissions": {
    "allow": [
      "Bash(powershell -NoProfile -Command \"Get-Process python,pythonw -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue\")",
      "Bash(rm -rf venv_test)",
      "Bash(cp venv/Scripts/python.exe venv/Scripts/python.exe.launcher-bak)",
      "Bash(cp venv/Scripts/pythonw.exe venv/Scripts/pythonw.exe.launcher-bak)",
      "Bash(cp C:/Python312/python.exe venv/Scripts/python.exe)",
      "Bash(venv/Scripts/python.exe -c \"import time; time.sleep\\(8\\)\")",
      "Bash(git commit -m ' *)",
      "Bash(grep -oE '^[A-Z_]+=' .env)",
      "Bash(venv/Scripts/python.exe -c \"import anthropic; print\\('anthropic', anthropic.__version__\\)\")",
      "Bash(venv/Scripts/python.exe -c \"import telethon; print\\('telethon', telethon.__version__\\)\")",
      "Bash(venv/Scripts/python.exe -m py_compile collect_booking.py)",
      "Bash(venv/Scripts/python.exe -c ' *)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git show:*)",
      "Bash(git check-ignore:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git remote:*)",
      "Bash(venv/Scripts/python.exe -m pytest:*)",
      "Bash(venv/Scripts/python.exe -m py_compile:*)",
      "Bash(venv/Scripts/python.exe -m unittest:*)",
      "Bash(venv/Scripts/python.exe cowork_log_append.py:*)",
      "Bash(venv/Scripts/python.exe dispatch_notify.py:*)",
      "Read(//d/turbobaby-bot/**)",
      "Edit(//d/turbobaby-bot/**)",
      "Write(//d/turbobaby-bot/**)",
      "Bash(*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "D:/turbobaby-bot/venv/Scripts/python.exe D:/turbobaby-bot/dispatch_notify.py --hook notification"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "D:/turbobaby-bot/venv/Scripts/python.exe D:/turbobaby-bot/dispatch_notify.py --hook stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "D:/turbobaby-bot/venv/Scripts/python.exe D:/turbobaby-bot/dispatch_notify.py --hook session_end"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|Read|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "D:/turbobaby-bot/venv/Scripts/python.exe D:/turbobaby-bot/pretool_guard.py"
          }
        ]
      }
    ]
  }
}